<!DOCTYPE html>
<html>
<head>
  <title>RottenPotatoes!</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application" %>
  <%= javascript_include_tag "application" %>
</head>

<body>
<% if flash[:notice] %>
  <div id="notice" class="message"><%= flash[:notice] %></div>
<% elsif flash[:warning] %>
  <div id="warning" class="message"><%= flash[:warning] %></div>
<% end %>

<div id="main">
  <%= yield %>
</div>
</body>
</html>