%p{style: "color: green"}
  = "teste"

- content_for :title, "Movies"

%h1 Movies

%p
  Ordenar por:
  = link_to "Título", movies_path(sort: "title")
  |
  = link_to "Lançamento", movies_path(sort: "release_date")

%div{id: "movies"}
  - @movies.each do |movie|
    = render movie
    %p
      = link_to "Show this movie", movie

= link_to "New movie", new_movie_path
